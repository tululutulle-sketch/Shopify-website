{%- comment -%}
  Cart line items, shared by the cart drawer and cart page.
  - context: 'drawer' | 'page'
{%- endcomment -%}
<ul class="list-unstyled cart-items" role="list" data-cart-items>
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-item__media media media--square" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: widths: '100, 150, 200, 300', sizes: '(min-width: 768px) 110px, 88px', loading: 'lazy', alt: item.image.alt | default: item.product.title | escape }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <div class="cart-item__top">
          <div>
            <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
            {%- unless item.product.has_only_default_variant -%}
              <p class="caption cart-item__variant">
                {%- for option in item.options_with_values -%}
                  {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                {%- endfor -%}
              </p>
            {%- endunless -%}
            {%- for property in item.properties -%}
              {%- assign first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and first_char != '_' -%}
                <p class="caption cart-item__property">{{ property.first }}: {{ property.last }}</p>
              {%- endif -%}
            {%- endfor -%}
            {%- if item.selling_plan_allocation -%}
              <p class="caption">{{ item.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}
          </div>
          <div class="cart-item__price">
            {%- if item.original_line_price != item.final_line_price -%}
              <s class="price__compare">{{ item.original_line_price | money }}</s>
            {%- endif -%}
            <span class="price__current">{{ item.final_line_price | money }}</span>
          </div>
        </div>

        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="list-unstyled cart-item__discounts" role="list">
            {%- for allocation in item.line_level_discount_allocations -%}
              <li class="caption">{% render 'icon', icon: 'gift' %} {{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cart-item__bottom">
          <quantity-input class="quantity quantity--small">
            <button type="button" class="quantity__button" name="minus" aria-label="{{ 'accessibility.decrease_quantity' | t: product: item.product.title | escape }}">{% render 'icon', icon: 'minus' %}</button>
            <label class="visually-hidden" for="Qty-{{ context }}-{{ forloop.index }}">{{ 'accessibility.quantity' | t }}</label>
            <input
              class="quantity__input"
              type="number"
              id="Qty-{{ context }}-{{ forloop.index }}"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              inputmode="numeric"
              data-line-quantity="{{ forloop.index }}"
            >
            <button type="button" class="quantity__button" name="plus" aria-label="{{ 'accessibility.increase_quantity' | t: product: item.product.title | escape }}">{% render 'icon', icon: 'plus' %}</button>
          </quantity-input>
          <a href="{{ item.url_to_remove }}" class="link cart-item__remove" data-line-remove="{{ forloop.index }}" aria-label="{{ 'accessibility.remove' | t: product: item.product.title | escape }}">
            {{ 'cart.general.remove' | t }}
          </a>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
