{%- comment -%}
  Minimal line icons. Usage: {% render 'icon', icon: 'bag' %}
{%- endcomment -%}
{%- capture attrs -%}class="icon icon--{{ icon }}" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
  {%- when 'account' -%}
    <svg {{ attrs }}><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
  {%- when 'heart' -%}
    <svg {{ attrs }}><path d="M12 20s-7.5-4.4-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.6 12 20 12 20Z"/></svg>
  {%- when 'bag' -%}
    <svg {{ attrs }}><path d="M5.5 8h13l-1 12.5h-11Z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M3.5 7h17M3.5 12h17M3.5 17h11"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }}><path d="m6 6 12 12M18 6 6 18"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ attrs }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg {{ attrs }}><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg {{ attrs }}><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ attrs }}><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
  {%- when 'plus' -%}
    <svg {{ attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg {{ attrs }}><path d="M5 12h14"/></svg>
  {%- when 'filter' -%}
    <svg {{ attrs }}><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
  {%- when 'gift' -%}
    <svg {{ attrs }}><rect x="3.5" y="8.5" width="17" height="4" rx=".5"/><path d="M5 12.5v8h14v-8M12 8.5v12"/><path d="M12 8.5S10.8 4 8.5 4C7 4 6.5 5.2 6.8 6.2c.5 1.6 3 2.3 5.2 2.3ZM12 8.5S13.2 4 15.5 4c1.5 0 2 1.2 1.7 2.2-.5 1.6-3 2.3-5.2 2.3Z"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M2.5 6.5h11v10h-11ZM13.5 10h4l3 3v3.5h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'return' -%}
    <svg {{ attrs }}><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
  {%- when 'check' -%}
    <svg {{ attrs }}><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon--star" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="m12 3.2 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.7l-5.4 3 1.2-6L3.3 9.5l6.1-.7Z"/></svg>
  {%- when 'info' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/></svg>
  {%- when 'sparkle' -%}
    <svg {{ attrs }}><path d="M12 3.5c.6 4.3 2.2 5.9 6.5 6.5-4.3.6-5.9 2.2-6.5 6.5-.6-4.3-2.2-5.9-6.5-6.5 4.3-.6 5.9-2.2 6.5-6.5Z"/><path d="M18.5 16c.2 1.4.8 2 2.2 2.2-1.4.2-2 .8-2.2 2.2-.2-1.4-.8-2-2.2-2.2 1.4-.2 2-.8 2.2-2.2Z"/></svg>
  {%- when 'instagram' -%}
    <svg {{ attrs }}><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg {{ attrs }}><path d="M14.5 8H16V4.5h-2.2C11.3 4.5 10 6 10 8.4V10H8v3.5h2v7h3.5v-7h2.3l.5-3.5h-2.8V8.7c0-.5.4-.7 1-.7Z"/></svg>
  {%- when 'pinterest' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="8.5"/><path d="m10.5 20 1.7-7.2M10.4 13.6c.4 1 1.3 1.5 2.4 1.5 2.1 0 3.4-2 3.4-4.3 0-2.4-1.9-4-4.2-4-2.7 0-4.3 2-4.3 4 0 .9.3 1.7.9 2.1"/></svg>
  {%- when 'youtube' -%}
    <svg {{ attrs }}><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10.5 9.5 4 2.5-4 2.5Z" fill="currentColor"/></svg>
  {%- when 'whatsapp' -%}
    <svg {{ attrs }}><path d="M4 20l1.2-4A8 8 0 1 1 8.4 19Z"/><path d="M9 8.5c0 3.5 2.9 6.5 6.5 6.5l1-1.5-2-1-1 .8a5 5 0 0 1-2.3-2.3l.8-1-1-2Z"/></svg>
  {%- when 'play' -%}
    <svg {{ attrs }}><path d="M8 5.5v13l10-6.5Z"/></svg>
  {%- when 'pause' -%}
    <svg {{ attrs }}><path d="M8.5 5.5v13M15.5 5.5v13"/></svg>
{%- endcase -%}
