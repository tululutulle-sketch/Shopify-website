{%- comment -%}
  Merchant-configurable free shipping progress (Theme settings › Cart).
  The threshold is in the store's default currency.
{%- endcomment -%}
{%- if settings.free_shipping_enable and settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
    assign remaining_money = remaining | money
  -%}
  <div class="shipping-bar{% if remaining <= 0 %} is-complete{% endif %}">
    <p class="shipping-bar__text">
      {% render 'icon', icon: 'truck' %}
      {%- if remaining > 0 -%}
        {{ settings.free_shipping_message | replace: '[amount]', remaining_money }}
      {%- else -%}
        {{ settings.free_shipping_success }}
      {%- endif -%}
    </p>
    <div class="shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress | round }}">
      <span class="shipping-bar__fill" style="width: {{ progress }}%;"></span>
    </div>
  </div>
{%- endif -%}
