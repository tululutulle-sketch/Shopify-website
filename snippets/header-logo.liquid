{%- comment -%}
  Renders the uploaded TULULU logo at its original proportions (no cropping),
  or the shop name as a typographic fallback until the logo is uploaded.
  - tag_h1: boolean, wrap in h1 (homepage)
  - logo: optional image override (footer)
  - class: extra classes
{%- endcomment -%}
{%- liquid
  assign logo_image = logo | default: settings.logo
  if tag_h1
    assign tag = 'h1'
  else
    assign tag = 'div'
  endif
-%}
<{{ tag }} class="logo {{ class }}">
  <a href="{{ routes.root_url }}" class="logo__link">
    {%- if logo_image != blank -%}
      {%- assign logo_w2 = settings.logo_width | times: 2 -%}
      {{
        logo_image
        | image_url: width: logo_w2
        | image_tag:
          class: 'logo__image',
          widths: '120, 200, 280, 360, 520',
          sizes: '(min-width: 768px) 260px, 200px',
          alt: shop.name,
          loading: 'eager'
      }}
    {%- else -%}
      <span class="logo__text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
</{{ tag }}>
