<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- endif -%}
    <meta name="robots" content="noindex">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- liquid
      assign heading_query = settings.heading_font | default: 'Playfair Display' | replace: ' ', '+' | append: ':wght@400;500'
      assign body_query = settings.body_font | default: 'Inter' | replace: ' ', '+' | append: ':wght@400;500'
    -%}
    <link href="https://fonts.googleapis.com/css2?family={{ heading_query }}&family={{ body_query }}&display=swap" rel="stylesheet">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
