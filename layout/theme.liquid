<!doctype html>
{%- comment -%} TULULU theme layout {%- endcomment -%}
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- liquid
      assign page_title_full = page_title
      if current_tags
        assign tags_joined = current_tags | join: ', '
        assign page_title_full = page_title_full | append: ' – tagged "' | append: tags_joined | append: '"'
      endif
      if current_page != 1
        assign page_title_full = page_title_full | append: ' – Page ' | append: current_page
      endif
      unless page_title contains shop.name
        assign page_title_full = page_title_full | append: ' – ' | append: shop.name
      endunless
    -%}
    <title>{{ page_title_full }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign heading_font = settings.heading_font | default: 'Playfair Display'
      assign body_font = settings.body_font | default: 'Inter'
      assign heading_query = heading_font | replace: ' ', '+' | append: ':ital,wght@0,400;0,500;0,600;1,400'
      assign body_query = body_font | replace: ' ', '+' | append: ':wght@300;400;500;600'
    -%}
    <link href="https://fonts.googleapis.com/css2?family={{ heading_query }}&family={{ body_query }}&display=swap" rel="stylesheet">

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          wishlistEmpty: {{ 'wishlist.empty' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}

    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }}
          {%- if settings.logo != blank -%},
          "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if settings.social_instagram != blank -%},
          "sameAs": [{{ settings.social_instagram | json }}]
          {%- endif %}
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
            "query-input": "required name=search_term_string"
          }
        }
      </script>
    {%- endif -%}
  </head>

  <body class="{% unless settings.animations %}no-animations {% endunless %}template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <quick-add-modal class="modal" id="QuickAddModal" hidden>
      <div class="modal__overlay" data-close></div>
      <div class="modal__dialog" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_add' | t }}" tabindex="-1">
        <button type="button" class="modal__close icon-button" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
        <div class="modal__content" data-modal-content></div>
      </div>
    </quick-add-modal>

    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
