<section class="section contact">
  <div class="page-width page-width--narrow">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: 'center' %}
    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{% render 'icon', icon: 'check' %} {{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact__row">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
          <input class="field__input" type="text" id="ContactName" name="contact[{{ 'contact.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }} *</label>
          <input class="field__input" type="email" id="ContactEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
        <input class="field__input" type="tel" id="ContactPhone" name="contact[{{ 'contact.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel">
      </div>
      <div class="field">
        <label class="field__label" for="ContactBody">{{ 'contact.message' | t }}</label>
        <textarea class="field__textarea" rows="6" id="ContactBody" name="contact[{{ 'contact.message' | t }}]">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about an order or a gift? We'd love to hear from you.</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
