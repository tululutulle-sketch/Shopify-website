{%- liquid
  assign show_media = true
  if section.settings.image == blank and request.design_mode == false
    assign show_media = false
  endif
-%}
<section class="section section--{{ section.settings.background }} gifting-edit">
  <div class="page-width gifting-edit__grid gifting-edit__grid--{{ section.settings.image_position }}{% unless show_media %} gifting-edit__grid--no-media{% endunless %}">
    {%- if show_media -%}
    <div class="gifting-edit__media reveal">
      <div class="media media--portrait gifting-edit__image">
        {%- if section.settings.image != blank -%}
          {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 1024px) 50vw, 100vw', widths: '450, 650, 900, 1200, 1500' %}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if section.settings.image_2 != blank -%}
        <div class="media media--square gifting-edit__image-accent">
          {% render 'responsive-image', image: section.settings.image_2, sizes: '(min-width: 1024px) 18vw, 40vw', widths: '250, 400, 600' %}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="gifting-edit__content reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="display gifting-edit__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="rte gifting-edit__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="list-unstyled gifting-edit__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign c = block.settings.collection
              assign item_image = block.settings.image | default: c.image | default: c.featured_image
              assign item_title = block.settings.title | default: c.title
              assign item_url = c.url | default: '#'
            -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ item_url }}" class="gifting-edit__item">
                <span class="gifting-edit__thumb media media--square">
                  {%- if item_image != blank -%}
                    {{ item_image | image_url: width: 200 | image_tag: widths: '100, 200', sizes: '72px', loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {% render 'icon', icon: 'gift' %}
                  {%- endif -%}
                </span>
                <span class="gifting-edit__item-text">
                  <span class="gifting-edit__item-title">{{ item_title | default: 'Gift collection' | escape }}</span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="caption">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="gifting-edit__item-arrow" aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Gifting Edit",
  "class": "section-gifting-edit",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Main image", "info": "Packaging or gifting lifestyle photography. Portrait 4:5." },
    { "type": "image_picker", "id": "image_2", "label": "Accent image", "info": "Optional smaller overlapping image." },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The Gifting Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Art of Gifting." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtful little surprises, beautifully presented.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore gifting" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" },
        { "value": "lavender", "label": "Lavender" }
      ],
      "default": "blush"
    }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Gift collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Overrides the collection title." },
        { "type": "text", "id": "subtitle", "label": "Short description" },
        { "type": "image_picker", "id": "image", "label": "Thumbnail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Gifting Edit",
      "blocks": [
        { "type": "gift", "settings": { "title": "Hair Clip Combo Gift Boxes" } },
        { "type": "gift", "settings": { "title": "Surprise Gift Boxes" } },
        { "type": "gift", "settings": { "title": "Hair Accessory Bouquets" } }
      ]
    }
  ]
}
{% endschema %}
