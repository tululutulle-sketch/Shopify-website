{%- comment -%}
  Products the shopper viewed recently. Stored in their browser only, and
  rendered with the product card view (/products/{handle}?view=card).
{%- endcomment -%}
<recently-viewed
  class="section recently-viewed"
  data-current="{{ product.handle }}"
  data-limit="{{ section.settings.limit }}"
  hidden
>
  <div class="page-width">
    {% render 'section-heading', heading: section.settings.heading, align: 'center' %}
    <ul
      class="list-unstyled product-grid product-grid--scroll-mobile"
      role="list"
      style="--columns: {{ section.settings.columns }};"
      data-recently-viewed-grid
    ></ul>
  </div>
</recently-viewed>

{% schema %}
{
  "name": "Recently viewed",
  "class": "section-recently-viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Viewed" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Products per row (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "paragraph", "content": "Hidden until the shopper has viewed other products. History is kept in their browser only." }
  ],
  "presets": [{ "name": "Recently viewed" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
