{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_sticky = section.settings.sticky_atc
-%}
<product-info
  class="section section--tight-top product"
  id="Product-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-update-url="true"
>
  <div class="page-width">
    <nav class="breadcrumbs caption product__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a> <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="product__grid product__grid--{{ section.settings.media_size }}">
      <div class="product__media">
        {% render 'product-gallery', product: product, section_id: section.id, layout: section.settings.gallery_layout, ratio: section.settings.media_ratio %}
      </div>

      <div class="product__info">
        <div class="product__info-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="product__block">{% render block %}</div>

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <p class="product__block eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
                {%- endif -%}

              {%- when 'title' -%}
                <div class="product__block product__title-wrap" {{ block.shopify_attributes }}>
                  <h1 class="h1 product__title">{{ product.title | escape }}</h1>
                  {% render 'wishlist-button', product: product, class: 'product__wishlist' %}
                </div>

              {%- when 'price' -%}
                <div class="product__block product__price-wrap" {{ block.shopify_attributes }}>
                  <div data-price-container>
                    {% render 'price', product: product, use_variant: true, class: 'price--large' %}
                  </div>
                  <p class="caption product__tax">
                    {%- if cart.taxes_included -%}{{ 'products.product.tax_included' | t }} {% endif -%}
                    {{ 'products.product.shipping_calculated' | t }}
                  </p>
                </div>

              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <a href="#ProductReviews" class="product__block product__rating" {{ block.shopify_attributes }}>
                    {%- liquid
                      assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
                      assign rating_max = product.metafields.reviews.rating.value.scale_max
                      assign rating_count = product.metafields.reviews.rating_count.value
                    -%}
                    {% render 'rating', rating: rating_value, max: rating_max, count: rating_count %}
                  </a>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                <div class="product__block" {{ block.shopify_attributes }}>
                  {% render 'variant-picker', product: product, section_id: section.id, picker_type: block.settings.picker_type, swatches: block.settings.swatches %}
                  {%- if block.settings.size_guide_page != blank -%}
                    <button type="button" class="link product__size-guide" data-modal-open="SizeGuide-{{ block.id }}">
                      {{ block.settings.size_guide_label | default: 'Size guide' | escape }}
                    </button>
                    <dialog-modal class="modal" id="SizeGuide-{{ block.id }}" hidden>
                      <div class="modal__overlay" data-close></div>
                      <div class="modal__dialog modal__dialog--text" role="dialog" aria-modal="true" aria-label="{{ block.settings.size_guide_page.title | escape }}" tabindex="-1">
                        <button type="button" class="modal__close icon-button" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
                        <h2 class="h3">{{ block.settings.size_guide_page.title | escape }}</h2>
                        <div class="rte">{{ block.settings.size_guide_page.content }}</div>
                      </div>
                    </dialog-modal>
                  {%- endif -%}
                </div>

              {%- when 'inventory' -%}
                <p class="product__block product__inventory caption" data-inventory data-low-threshold="{{ block.settings.low_stock_threshold }}" {{ block.shopify_attributes }}>
                  {%- render 'inventory-status', variant: current_variant, threshold: block.settings.low_stock_threshold -%}
                </p>

              {%- when 'buy_buttons' -%}
                <div class="product__block product__buy" data-main-buy {{ block.shopify_attributes }}>
                  {% render 'buy-buttons', product: product, section_id: section.id, show_quantity: block.settings.show_quantity, show_dynamic_checkout: block.settings.show_dynamic_checkout %}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__block rte product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
                {%- endif -%}

              {%- when 'delivery' -%}
                <ul class="product__block list-unstyled product__perks" role="list" {{ block.shopify_attributes }}>
                  {%- if block.settings.line_1 != blank -%}<li>{% render 'icon', icon: 'truck' %}<span>{{ block.settings.line_1 }}</span></li>{%- endif -%}
                  {%- if block.settings.line_2 != blank -%}<li>{% render 'icon', icon: 'gift' %}<span>{{ block.settings.line_2 }}</span></li>{%- endif -%}
                  {%- if block.settings.line_3 != blank -%}<li>{% render 'icon', icon: 'return' %}<span>{{ block.settings.line_3 }}</span></li>{%- endif -%}
                </ul>

              {%- when 'whats_inside' -%}
                {%- liquid
                  assign inside = block.settings.content
                  if inside == blank
                    assign inside = product.metafields.custom.whats_inside | metafield_tag
                  endif
                -%}
                {%- if inside != blank -%}
                  <div class="product__block product-callout product-callout--blush" {{ block.shopify_attributes }}>
                    <p class="product-callout__title">{% render 'icon', icon: 'gift' %} {{ block.settings.heading | escape }}</p>
                    <div class="rte product-callout__body">{{ inside }}</div>
                  </div>
                {%- elsif request.design_mode -%}
                  <div class="product__block editor-notice" {{ block.shopify_attributes }}><p>“What's inside?” is empty. Add content here or fill the <code>custom.whats_inside</code> product metafield.</p></div>
                {%- endif -%}

              {%- when 'surprise_note' -%}
                {%- liquid
                  assign note = block.settings.content
                  if note == blank
                    assign note = product.metafields.custom.surprise_details | metafield_tag
                  endif
                -%}
                {%- if note != blank or block.settings.limitations != blank -%}
                  <div class="product__block product-callout product-callout--lavender" {{ block.shopify_attributes }}>
                    <p class="product-callout__title">{% render 'icon', icon: 'sparkle' %} {{ block.settings.heading | escape }}</p>
                    {%- if note != blank -%}<div class="rte product-callout__body">{{ note }}</div>{%- endif -%}
                    {%- if block.settings.limitations != blank -%}
                      <div class="rte product-callout__note caption">{% render 'icon', icon: 'info' %} {{ block.settings.limitations }}</div>
                    {%- endif -%}
                  </div>
                {%- elsif request.design_mode -%}
                  <div class="product__block editor-notice" {{ block.shopify_attributes }}><p>Surprise box note is empty. Add content here or fill the <code>custom.surprise_details</code> product metafield.</p></div>
                {%- endif -%}

              {%- when 'gift_details' -%}
                {%- liquid
                  assign gift = block.settings.content
                  if gift == blank
                    assign gift = product.metafields.custom.gifting_details | metafield_tag
                  endif
                -%}
                {%- if gift != blank -%}
                  <div class="product__block product-callout product-callout--cream" {{ block.shopify_attributes }}>
                    <p class="product-callout__title">{% render 'icon', icon: 'heart' %} {{ block.settings.heading | escape }}</p>
                    <div class="rte product-callout__body">{{ gift }}</div>
                  </div>
                {%- endif -%}

              {%- when 'collapsible' -%}
                {%- liquid
                  assign tab_content = block.settings.content
                  if block.settings.page != blank
                    assign tab_content = tab_content | append: block.settings.page.content
                  endif
                  if block.settings.use_shipping_default and tab_content == blank
                    assign tab_content = settings.shipping_returns_text
                    if settings.shipping_returns_page != blank
                      assign page_link = settings.shipping_returns_page.url | prepend: '<p><a href="' | append: '">' | append: settings.shipping_returns_page.title | append: '</a></p>'
                      assign tab_content = tab_content | append: page_link
                    endif
                  endif
                -%}
                {%- if tab_content != blank -%}
                  <details class="product__block accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                    <summary class="accordion__summary">
                      <span class="accordion__title">{% render 'icon', icon: block.settings.icon %}{{ block.settings.heading | escape }}</span>
                      {% render 'icon', icon: 'plus' %}
                    </summary>
                    <div class="accordion__content rte">{{ tab_content }}</div>
                  </details>
                {%- endif -%}

              {%- when 'share' -%}
                <div class="product__block product__share" {{ block.shopify_attributes }}>
                  <share-button class="share-button" data-url="{{ request.origin }}{{ product.url }}" data-title="{{ product.title | escape }}">
                    <button type="button" class="link">{{ 'products.product.share' | t }}</button>
                  </share-button>
                </div>

              {%- when 'custom_liquid' -%}
                <div class="product__block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
            {%- endcase -%}
          {%- endfor -%}

          {%- if product.selected_or_first_available_variant.sku != blank and section.settings.show_sku -%}
            <p class="caption product__sku">{{ 'products.product.sku' | t }}: <span data-sku>{{ current_variant.sku }}</span></p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- if show_sticky -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc__inner">
        <div class="sticky-atc__product">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 120 | image_tag: widths: '60, 120', sizes: '44px', loading: 'lazy', alt: '', class: 'sticky-atc__image' }}
          {%- endif -%}
          <div class="sticky-atc__text">
            <p class="sticky-atc__title">{{ product.title | escape }}</p>
            <div data-sticky-price>{% render 'price', product: product, use_variant: true %}</div>
          </div>
        </div>
        <button
          type="submit"
          form="ProductForm-{{ section.id }}"
          class="button sticky-atc__button"
          data-sticky-add
          tabindex="-1"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>
</product-info>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Desktop gallery",
      "options": [
        { "value": "thumbnails", "label": "Large image with thumbnails" },
        { "value": "grid", "label": "Editorial grid" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "natural", "label": "Original" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Desktop image width",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky add to cart on mobile", "default": true },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "text",
      "name": "Small heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "info": "Connect to a metafield or the vendor with the dynamic source button." }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "rating",
      "name": "Product rating",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows stars only when a review app provides genuine rating data (reviews.rating metafield)." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Style",
          "options": [
            { "value": "buttons", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "buttons"
        },
        { "type": "checkbox", "id": "swatches", "label": "Show colour swatches", "default": true, "info": "Applies to options named Colour or Color." },
        { "type": "page", "id": "size_guide_page", "label": "Size guide page", "info": "Useful for tutu skirts." },
        { "type": "text", "id": "size_guide_label", "label": "Size guide label", "default": "Size guide" }
      ]
    },
    {
      "type": "inventory",
      "name": "Availability",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "low_stock_threshold", "label": "Low stock message below", "min": 0, "max": 20, "step": 1, "default": 5, "info": "Only for products where Shopify tracks inventory. 0 disables it." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show \"Buy it now\" button", "default": true, "info": "Shopify dynamic checkout buttons. Payment options depend on your checkout settings." }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "delivery",
      "name": "Delivery information",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "line_1", "label": "Delivery line", "default": "Free shipping on orders above ₹999" },
        { "type": "inline_richtext", "id": "line_2", "label": "Gifting line", "default": "Beautifully gift-wrapped" },
        { "type": "inline_richtext", "id": "line_3", "label": "Returns line", "info": "State only your actual returns policy." }
      ]
    },
    {
      "type": "whats_inside",
      "name": "What's inside? (gift boxes)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "What's inside?" },
        { "type": "richtext", "id": "content", "label": "Contents", "info": "Leave empty to use the product metafield custom.whats_inside, or connect a metafield with the dynamic source button." }
      ]
    },
    {
      "type": "surprise_note",
      "name": "Surprise box details",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About your surprise" },
        { "type": "richtext", "id": "content", "label": "Explanation", "info": "Leave empty to use the product metafield custom.surprise_details." },
        { "type": "richtext", "id": "limitations", "label": "Limitations", "info": "e.g. contents vary and cannot be chosen; colours may differ from photos." }
      ]
    },
    {
      "type": "gift_details",
      "name": "Gifting details (bouquets)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Gifting details" },
        { "type": "richtext", "id": "content", "label": "Content", "info": "Leave empty to use the product metafield custom.gifting_details." }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "info", "label": "Info" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "info"
        },
        { "type": "richtext", "id": "content", "label": "Content", "info": "Connect a metafield with the dynamic source button for product-specific details." },
        { "type": "page", "id": "page", "label": "Content from page" },
        { "type": "checkbox", "id": "use_shipping_default", "label": "Use default shipping & returns text", "default": false, "info": "When empty, shows Theme settings › Product page › Shipping & returns." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }]
    }
  ]
}
{% endschema %}
