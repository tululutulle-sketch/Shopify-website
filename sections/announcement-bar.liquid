{%- if section.blocks.size > 0 -%}
  <announcement-bar
    class="announcement-bar"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.speed | times: 1000 }}"
    style="--ab-bg: {{ section.settings.background }}; --ab-fg: {{ section.settings.text_color }};"
    role="region"
    aria-label="Announcements"
    {{ section.shopify_attributes }}
  >
    <div class="announcement-bar__inner page-width">
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__arrow" data-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
      {%- endif -%}
      <div class="announcement-bar__track" aria-live="off">
        {%- for block in section.blocks -%}
          <p class="announcement-bar__message{% if forloop.first %} is-active{% endif %}" {% unless forloop.first %}aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__arrow" data-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Rotate messages automatically", "default": true },
    { "type": "range", "id": "speed", "label": "Change every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "color", "id": "background", "label": "Background", "default": "#E56B8C" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free Shipping on Orders Above ₹999" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free Shipping on Orders Above ₹999" } },
        { "type": "announcement", "settings": { "text": "Beautifully Gift-Wrapped" } },
        { "type": "announcement", "settings": { "text": "Discover Our Latest Collections" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
