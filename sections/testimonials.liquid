{%- comment -%}
  Customer reviews. Add only genuine reviews (as Review blocks) or add a review
  app block (Judge.me, Loox, Shopify Product Reviews, etc.). Nothing is shown
  on the live store when the section has no content.
{%- endcomment -%}
{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign has_content = false
  if section.blocks.size > 0
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  <section class="section section--{{ section.settings.background }} testimonials">
    <div class="page-width">
      {% render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text,
        align: 'center'
      %}

      {%- if review_blocks.size > 0 -%}
        <ul class="list-unstyled scroller testimonials__grid" role="list">
          {%- for block in review_blocks -%}
            <li class="testimonial reveal" style="--reveal-delay: {{ forloop.index0 | times: 60 }}ms;" {{ block.shopify_attributes }}>
              <figure class="testimonial__figure">
                {%- if block.settings.rating > 0 -%}
                  {% render 'rating', rating: block.settings.rating, max: 5 %}
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <p class="testimonial__title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                <blockquote class="testimonial__quote rte">{{ block.settings.quote }}</blockquote>
                <figcaption class="testimonial__author">
                  {%- if block.settings.author != blank -%}
                    <span class="testimonial__name">{{ block.settings.author | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.verified -%}
                    <span class="testimonial__verified caption">{% render 'icon', icon: 'check' %} {{ 'reviews.verified' | t }}</span>
                  {%- endif -%}
                </figcaption>
                {%- assign p = block.settings.product -%}
                {%- if p != blank -%}
                  <a href="{{ p.url }}" class="testimonial__product">
                    {%- if p.featured_image -%}
                      {{ p.featured_image | image_url: width: 120 | image_tag: widths: '60, 120', sizes: '48px', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span class="caption">{{ 'reviews.on_product' | t: product: p.title }}</span>
                  </a>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <div class="editor-notice">
          <p>Add genuine customer reviews as <strong>Review</strong> blocks, or add a review app block. This section is hidden from your store until it has content.</p>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="testimonials__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "class": "section-testimonials",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Our Customers" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" },
        { "value": "lavender", "label": "Lavender" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Only publish genuine reviews from real customers, with their permission." },
        { "type": "range", "id": "rating", "label": "Star rating (0 hides stars)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "richtext", "id": "quote", "label": "Review" },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false },
        { "type": "product", "id": "product", "label": "Product reviewed" }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
