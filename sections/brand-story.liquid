{%- liquid
  assign show_media = true
  if section.settings.image == blank and request.design_mode == false
    assign show_media = false
  endif
-%}
<section class="section section--{{ section.settings.background }} brand-story">
  <div class="page-width brand-story__grid brand-story__grid--{{ section.settings.image_position }}{% unless show_media %} brand-story__grid--no-media{% endunless %}">
    {%- if show_media -%}
    <div class="brand-story__media reveal">
      <div class="media media--{{ section.settings.image_ratio }} brand-story__image">
        {%- if section.settings.image != blank -%}
          {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 1024px) 45vw, 100vw', widths: '450, 650, 900, 1200, 1500' %}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if section.settings.image_2 != blank -%}
        <div class="media media--portrait brand-story__image brand-story__image--secondary">
          {% render 'responsive-image', image: section.settings.image_2, sizes: '(min-width: 1024px) 22vw, 50vw', widths: '300, 450, 650, 900' %}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="brand-story__content reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="display brand-story__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="rte brand-story__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="list-unstyled brand-story__values" role="list">
          {%- for block in section.blocks -%}
            <li class="brand-story__value" {{ block.shopify_attributes }}>
              <span class="brand-story__value-icon">{% render 'icon', icon: block.settings.icon %}</span>
              <div>
                <p class="brand-story__value-title">{{ block.settings.title | escape }}</p>
                {%- if block.settings.text != blank -%}<p class="caption">{{ block.settings.text | escape }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/pages/about-us' }}" class="link-arrow">{{ section.settings.button_label | escape }} {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "class": "section-brand-story",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_2", "label": "Second image", "info": "Optional." },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Details. Beautiful Moments." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>TULULU is a boutique of accessories and gifts chosen for the moments that matter — birthdays, celebrations and simple everyday surprises.</p><p>Every piece is selected with care and presented beautifully, so that giving feels as special as receiving.</p>",
      "info": "Tell your story in your own words. Only include claims about materials or production that you can verify."
    },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Link", "info": "Your About Us page." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" },
        { "value": "lavender", "label": "Lavender" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Delivery" },
            { "value": "check", "label": "Check" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Thoughtfully curated" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "value", "settings": { "icon": "sparkle", "title": "Thoughtfully curated" } },
        { "type": "value", "settings": { "icon": "gift", "title": "Beautifully presented" } }
      ]
    }
  ]
}
{% endschema %}
