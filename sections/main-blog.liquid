<section class="section section--tight-top main-blog">
  <div class="page-width">
    <h1 class="display main-blog__title">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 9 -%}
      <ul class="list-unstyled article-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="article-card">
              <div class="media media--landscape">
                {%- if article.image -%}
                  {% render 'responsive-image', image: article.image, sizes: '(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw', widths: '400, 600, 800, 1000' %}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="caption">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="h4">{{ article.title | escape }}</h2>
              <p class="caption">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate, type: 'pages' %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog posts", "class": "section-main-blog", "settings": [] }
{% endschema %}
