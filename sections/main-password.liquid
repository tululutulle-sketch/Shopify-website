<section class="section password">
  <div class="page-width page-width--narrow empty-state">
    {% render 'header-logo' %}
    <h1 class="display">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter', style: 'boxed' %}
    <details class="password__login">
      <summary class="link">{{ 'general.password_page.login' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="Password" class="visually-hidden">{{ 'general.password_page.password' | t }}</label>
        <input type="password" name="password" id="Password" class="field__input" placeholder="{{ 'general.password_page.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button">{{ 'general.password_page.submit' | t }}</button>
      {%- endform -%}
      <p class="caption">{{ 'general.password_page.owner' | t }} <a href="/admin" class="link">{{ 'general.password_page.admin_link' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }]
}
{% endschema %}
