{%- liquid
  assign columns = section.settings.columns
  assign card_sizes = '(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 46vw'
-%}
<product-recommendations
  class="section related-products"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      {% render 'section-heading', heading: section.settings.heading, align: 'center' %}
      <ul class="list-unstyled product-grid product-grid--scroll-mobile" role="list" style="--columns: {{ columns }};">
        {%- for product in recommendations.products -%}
          <li class="product-grid__item">
            {% render 'product-card', product: product, sizes: card_sizes %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Related products",
  "class": "section-related-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Love" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Products per row (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "paragraph", "content": "Recommendations are generated by Shopify. Customise them with the Search & Discovery app." }
  ],
  "presets": [{ "name": "Related products" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
