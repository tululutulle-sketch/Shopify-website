{%- liquid
  assign profile_url = section.settings.profile_url | default: settings.social_instagram
-%}
<section class="section section--{{ section.settings.background }} instagram">
  <div class="page-width">
    <div class="section-heading section-heading--center reveal">
      <div class="section-heading__titles">
        {%- if section.settings.handle != blank -%}
          <p class="eyebrow">
            {%- if profile_url != blank -%}
              <a href="{{ profile_url }}" target="_blank" rel="noopener">{{ section.settings.handle | escape }}</a>
            {%- else -%}
              {{ section.settings.handle | escape }}
            {%- endif -%}
          </p>
        {%- endif -%}
        <h2 class="h2 section-heading__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="section-heading__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.app_note != blank and section.blocks.size == 0 and request.design_mode -%}
      <div class="editor-notice"><p>{{ section.settings.app_note }}</p></div>
    {%- endif -%}

    <ul class="list-unstyled instagram__grid" role="list" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <li class="instagram__app">{% render block %}</li>
        {%- else -%}
          {%- assign tile_link = block.settings.link | default: profile_url -%}
          <li class="instagram__item reveal" style="--reveal-delay: {{ forloop.index0 | times: 40 }}ms;" {{ block.shopify_attributes }}>
            {%- if tile_link != blank -%}<a href="{{ tile_link }}" target="_blank" rel="noopener" class="instagram__link">{%- else -%}<div class="instagram__link">{%- endif -%}
              <div class="media media--square">
                {%- if block.settings.image != blank -%}
                  {% render 'responsive-image', image: block.settings.image, sizes: '(min-width: 1024px) 16vw, (min-width: 768px) 30vw, 33vw', widths: '200, 300, 450, 600' %}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="instagram__overlay" aria-hidden="true">{% render 'icon', icon: 'instagram' %}</span>
              {%- if tile_link != blank -%}<span class="visually-hidden">{{ block.settings.image.alt | default: 'Instagram post' | escape }}</span>{%- endif -%}
            {%- if tile_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if profile_url != blank and section.settings.button_label != blank -%}
      <div class="section__footer">
        <a href="{{ profile_url }}" class="button button--outline" target="_blank" rel="noopener">
          {% render 'icon', icon: 'instagram' %} {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram gallery",
  "class": "section-instagram",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the World of TULULU" },
    { "type": "text", "id": "handle", "label": "Instagram handle", "info": "e.g. @yourhandle" },
    { "type": "text", "id": "profile_url", "label": "Instagram profile URL", "info": "Defaults to Theme settings › Social media › Instagram." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "label": "Images per row (desktop)", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow us" },
    {
      "type": "text",
      "id": "app_note",
      "label": "Editor note",
      "default": "Upload images as blocks, or add an Instagram feed app block for a live feed."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Post link", "info": "Defaults to the profile URL." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
